# ─────────────────────────────────────────────────────────────
#  KEBBI CLINIC BACKEND — environment configuration
#  Copy to `.env` and fill in your real values.
# ─────────────────────────────────────────────────────────────

# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed frontend origins (the two Vite dev apps)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# MongoDB Atlas connection string (REQUIRED for production).
# Leave empty to fall back to a disposable in-memory MongoDB (local dev only).
# Format:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=

# JWT signing secret for staff/admin sessions — use a long random string.
JWT_SECRET=kebbi-clinic-dev-secret-change-in-production

# ── Cloudflare R2 (lab & radiology result images / PDFs) ──────
# When the four S3 keys are set, uploads go to R2; empty → local backend/uploads/.
# R2_PUBLIC_BASE_URL is the bucket's public URL (r2.dev or custom domain) used
# for downloads and returned by the upload endpoints.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# ── Mailtrap (transactional email) ──────────────────────────
# Preferred: API token only (https://mailtrap.io → Settings → API Tokens).
# Emails sent: staff welcome, password reset, wallet receipts, lab results, low stock.
# When MAIL_API_TOKEN is empty, emails are logged to the console instead.
MAIL_API_TOKEN=
MAIL_FROM=Kebbi Clinic <no-reply@kebbiclinic.ng>
# Alternative: SMTP (Nodemailer). Set both to use SMTP instead of the API token.
# MAIL_HOST=live.smtp.mailtrap.io
# MAIL_PORT=587
# MAIL_USER=api
# MAIL_PASS=<your API token>